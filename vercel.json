{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/orchestrate",
      "destination": "/api/index?route=/orchestrate"
    },
    {
      "source": "/tasks/:path*",
      "destination": "/api/index?route=/tasks/:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/index?route=/mcp"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/index?route=/oauth/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/index?route=/.well-known/:path*"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  }
}
