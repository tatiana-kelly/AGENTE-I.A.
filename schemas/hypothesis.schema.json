{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAL Hypothesis",
  "type": "object",
  "required": [
    "statement",
    "favorable_evidence",
    "contrary_evidence",
    "confidence",
    "status"
  ],
  "properties": {
    "statement": { "type": "string" },
    "favorable_evidence": { "type": "array", "items": { "type": "string" } },
    "contrary_evidence": { "type": "array", "items": { "type": "string" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "status": {
      "enum": ["untested", "confirmed", "refuted", "inconclusive"]
    }
  }
}
