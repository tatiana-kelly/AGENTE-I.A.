+def push_autorizado(ambiente=None):
+    """Push so com DRE_BRIDGE_ALLOW_PUSH=1 (exatamente "1"). Padrao: desligado."""
+    ambiente = os.environ if ambiente is None else ambiente
+    return (ambiente.get(VAR_PUSH) or "").strip() == "1"
+
