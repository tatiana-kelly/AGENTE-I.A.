{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sal.automation-incident/1.0",
  "title": "AUTOMATION_INCIDENT — Hermes Autonomy → SAL Intelligence OS",
  "description": "Evento TÉCNICO sobre a confiabilidade de uma automação. Hermes relata fatos técnicos (esperado vs real, evidência, diagnóstico, ações técnicas tentadas, validação técnica). Hermes NÃO decide, NÃO aprova e NÃO declara resultado de negócio. Quem decide sobre impacto empresarial é o SAL OS (Decision Router → decision cycle → aprovação humana). CONTRATO APENAS — sem transporte implementado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "event_id", "source", "automation_id", "timestamp", "severity",
               "incident_type", "expected", "actual", "evidence", "diagnosis", "confidence", "actions_attempted",
               "validation", "recurrence", "requires_human", "requires_business_decision", "authority",
               "ai_review_signals", "routing_context"],
  "properties": {
    "schema_version": {"const": "sal.automation-incident/1.0"},
    "event_type": {"const": "AUTOMATION_INCIDENT"},
    "event_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$",
                 "description": "sha256(incident_id|lifecycle_state) — idempotente: o mesmo estado do mesmo incidente gera o mesmo id."},
    "source": {"const": "hermes-autonomy"},
    "automation_id": {"type": "string", "minLength": 1},
    "automation_name": {"type": "string"},
    "project_id": {"type": ["string", "null"], "description": "project_id do AI Orchestrator (ex.: torre-controle), quando mapeado no registry."},
    "incident_id": {"type": "string"},
    "root_cause_id": {"type": ["string", "null"]},
    "timestamp": {"type": "string", "format": "date-time", "description": "ISO-8601 com offset."},
    "severity": {"enum": ["P0", "P1", "P2", "P3"],
                 "description": "Severidade TÉCNICA do incidente da automação. Não é a prioridade de negócio (essa é calculada pelo SAL OS)."},
    "incident_type": {"enum": ["MISSED_EXECUTION", "DELAYED_EXECUTION", "FAILED_EXECUTION", "PARTIAL_EXECUTION",
                               "MISSING_OUTPUT", "INVALID_OUTPUT", "DATA_NOT_UPDATED", "DELIVERY_FAILURE",
                               "AUTHENTICATION_FAILURE", "API_FAILURE", "DEPENDENCY_FAILURE", "RESOURCE_FAILURE",
                               "UNKNOWN_FAILURE", "RECURRING_FAILURE", "ROOT_CAUSE_INCIDENT"]},
    "lifecycle_state": {"enum": ["DETECTED", "CLASSIFIED", "DIAGNOSING", "DIAGNOSED", "REPAIRING", "VALIDATING",
                                 "RESOLVED", "ESCALATED"]},
    "outcome": {"type": ["string", "null"],
                "enum": ["AUTO_RECOVERED", "ALREADY_OK", "DELAY_RECORDED", "ESCALATED", "ESCALATED_WITH_ACTION_REQUIRED",
                         "CIRCUIT_BREAKER_OPEN", "DRY_RUN_PLANNED", "RATE_LIMITED", null]},
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["window", "criteria"],
      "properties": {
        "window": {"type": ["string", "null"], "format": "date-time", "description": "Horário em que a automação deveria ter rodado."},
        "criteria": {"type": "array", "items": {"type": "string"}, "description": "Critérios declarados no registry (PROCESS_STARTED, OUTPUT_EXISTS, DATA_UPDATED...)."},
        "outputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "actual": {
      "type": "object", "additionalProperties": false, "required": ["run_started_at", "criteria_results"],
      "properties": {
        "run_started_at": {"type": ["string", "null"], "format": "date-time"},
        "criteria_results": {"type": "object",
                             "propertyNames": {"enum": ["PROCESS_STARTED", "ON_TIME", "PROCESS_FINISHED", "OUTPUT_EXISTS",
                                                        "OUTPUT_VALID", "DATA_UPDATED", "DELIVERY_COMPLETED", "DEPENDENCY_OK"]},
                             "additionalProperties": {"enum": ["pass", "fail", "unverifiable"]}},
        "summary": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array", "maxItems": 50,
      "items": {"type": "object", "additionalProperties": false, "required": ["criterion", "result", "source", "detail"],
                "properties": {"criterion": {"type": "string"}, "result": {"enum": ["pass", "fail", "unverifiable"]},
                               "source": {"type": "string"}, "detail": {"type": "string", "description": "Texto já redigido (sem segredos)."},
                               "ref": {"type": ["string", "null"], "description": "Caminho de log/arquivo ou URL de run."}}}
    },
    "diagnosis": {
      "type": "object", "additionalProperties": false, "required": ["cause_code", "probable_cause", "transient"],
      "properties": {
        "cause_code": {"type": "string", "description": "Ex.: NETWORK_TIMEOUT, TASK_ACCESS_DENIED, UNKNOWN_CAUSE."},
        "probable_cause": {"type": "string"},
        "cause_key": {"type": "string"},
        "transient": {"type": "boolean"},
        "investigation_steps": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                "required": ["step", "name", "result"],
                                "properties": {"step": {"type": "string"}, "name": {"type": "string"},
                                               "result": {"type": "string"}}}}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "actions_attempted": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["attempt", "action", "risk_level", "dry_run", "result"],
                "properties": {"attempt": {"type": "integer", "minimum": 0}, "action": {"type": "string",
                               "description": "Somente ações TÉCNICAS da matriz do Reparador (rerun_task, rerun_command, restart_task, cleanup_temp)."},
                               "risk_level": {"enum": ["low", "medium", "high"]}, "dry_run": {"type": "boolean"},
                               "result": {"type": "string"}}}
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["scope", "status"],
      "properties": {
        "scope": {"const": "technical", "description": "Validação TÉCNICA da execução da automação. Nunca é verificação de resultado de negócio."},
        "status": {"enum": ["TECHNICAL_OK", "TECHNICAL_FAIL", "NOT_RUN", "INSUFFICIENT_EVIDENCE"]},
        "validated_by": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recurrence": {
      "type": "object", "additionalProperties": false, "required": ["count"],
      "properties": {"count": {"type": "integer", "minimum": 0, "description": "Ocorrências anteriores da mesma causa nesta automação."},
                     "last_resolution": {"type": ["string", "null"]},
                     "circuit_breaker_open": {"type": "boolean"}}
    },
    "requires_human": {"type": "boolean", "description": "Precisa de intervenção humana TÉCNICA (credencial, permissão, dependência)."},
    "human_action": {"type": ["string", "null"]},
    "requires_business_decision": {"type": "boolean",
                                   "description": "true quando o incidente técnico deixou dado/entrega de negócio ausente, desatualizado ou suspeito além da janela declarada — o SAL OS decide o que fazer. Hermes não sugere decisão empresarial."},
    "business_impact": {"type": ["string", "null"], "description": "Impacto declarado no registry (fato), não recomendação."},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["can_repair_technical_low_risk", "can_approve_business_decision", "can_execute_business_action",
                   "can_declare_business_verified"],
      "properties": {
        "can_repair_technical_low_risk": {"type": "boolean"},
        "can_approve_business_decision": {"const": false},
        "can_execute_business_action": {"const": false},
        "can_declare_business_verified": {"const": false}
      }
    },
    "ai_review_signals": {
      "type": "object", "additionalProperties": false,
      "description": "EVIDÊNCIAS para a camada de decisão (AI Orchestrator / SAL OS) decidir se vale gastar uma chamada de IA. O Hermes NÃO decide chamar IA e NÃO emite recomendação de chamada — só fatos.",
      "required": ["unknown_cause", "confidence", "conflicting_evidence", "repeated_failure", "actions_attempted"],
      "properties": {
        "unknown_cause": {"type": "boolean", "description": "diagnosis.cause_code == UNKNOWN_CAUSE."},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "Espelho de confidence (0–1)."},
        "conflicting_evidence": {
          "type": "object", "additionalProperties": false, "required": ["present", "cause_codes"],
          "properties": {"present": {"type": "boolean", "description": "≥ 2 causas catalogadas de tipos diferentes com evidência no mesmo incidente."},
                         "cause_codes": {"type": "array", "items": {"type": "string"}}}
        },
        "repeated_failure": {
          "type": "object", "additionalProperties": false, "required": ["present", "count_window", "window_hours"],
          "properties": {"present": {"type": "boolean"}, "count_window": {"type": "integer", "minimum": 0},
                         "window_hours": {"type": "integer", "minimum": 1},
                         "auto_recovered_same_cause": {"type": "integer", "minimum": 0,
                                                       "description": "Quantas vezes a mesma causa foi 'recuperada' — recorrência mascarada."},
                         "circuit_breaker_open": {"type": "boolean"}}
        },
        "actions_attempted": {"type": "integer", "minimum": 0, "description": "Total de tentativas técnicas (detalhe em actions_attempted)."}
      }
    },
    "routing_context": {
      "type": "object", "additionalProperties": false,
      "description": "Dados que o SAL OS precisa para montar um AlertEnvelope do Decision Router (o mapeamento é responsabilidade do SAL OS).",
      "required": ["entity_type", "entity_id", "period", "registry_version", "last_success_at", "affected_outputs",
                   "missing_data", "evidence_completeness_pct"],
      "properties": {
        "entity_type": {"const": "automation"},
        "entity_id": {"type": "string"},
        "period": {"type": "string", "description": "Data da janela esperada (YYYY-MM-DD)."},
        "registry_version": {"type": "string", "description": "Versão/sha do registry — mapeia para rules_version."},
        "last_success_at": {"type": ["string", "null"], "format": "date-time", "description": "Última execução com validação técnica OK — mapeia para quality_inputs.last_updated_at."},
        "stale_hours": {"type": ["number", "null"], "minimum": 0},
        "max_age_hours": {"type": ["number", "null"], "minimum": 0},
        "affected_outputs": {"type": "array", "items": {"type": "string"}},
        "missing_data": {"type": "array", "items": {"type": "string"}, "description": "Critérios não verificáveis (unverifiable)."},
        "evidence_completeness_pct": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "audit_ref": {"type": "string", "description": "Referência ao audit_log técnico local do Hermes (ex.: incident_id)."}
  },
  "$comment": "Chaves PROIBIDAS em qualquer nível (mesma lista do AI Orchestrator /v1/agent-runs): approved_decision, execute_action, executed_action, verified_ok (e variantes camelCase)."
}
