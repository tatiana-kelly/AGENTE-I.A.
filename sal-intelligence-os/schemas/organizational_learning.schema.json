{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAL OrganizationalLearning",
  "type": "object",
  "required": [
    "pattern",
    "intervention",
    "lesson",
    "confidence"
  ],
  "properties": {
    "pattern": { "type": "string" },
    "intervention": { "type": "string" },
    "predicted_impact": { "type": ["number", "null"] },
    "actual_impact": { "type": ["number", "null"] },
    "conditions": { "type": ["string", "null"] },
    "lesson": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
