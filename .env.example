# SAL AI OS — AI Orchestrator
# Copie para .env e preencha. Nunca commitar .env real (ver .gitignore).

# --- Providers (nenhuma chave tem valor default — Fase 2 implementa as chamadas reais) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MANUS_API_KEY=
GEMINI_API_KEY=

# --- Supabase (persistência de ai_tasks/ai_runs/ai_evidence — ver Fase 11) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Execução (Fase 7) ---
# READ_ONLY | ASSISTED | AUTONOMOUS — default é sempre READ_ONLY
ORCHESTRATOR_MODE=READ_ONLY
DRY_RUN=true

# --- Cost Control (Fase 16) ---
MAX_COST_PER_TASK_USD=1.00
REQUIRE_CONFIRMATION_ABOVE_USD=0.50

# --- n8n (Fase 13 — trigger layer, não substitui o n8n) ---
N8N_WEBHOOK_SECRET=

# --- Observability ---
LOG_LEVEL=info
