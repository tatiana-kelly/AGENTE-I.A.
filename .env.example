# SAL AI OS — AI Orchestrator
# Copie para .env e preencha. Nunca commitar .env real (ver .gitignore).

# --- Providers (nenhuma chave tem valor default) ---
# Um provider só é registrado no Provider Manager se sua API key existir.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_CRITICAL=gpt-5.6-sol
OPENAI_MODEL_ADVERSARIAL=gpt-5.6-sol
OPENAI_MODEL_BUILDER=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_COST_PER_CALL_USD=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-sonnet-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5
ANTHROPIC_MODEL_CRITICAL=claude-opus-5
ANTHROPIC_MODEL_ADVERSARIAL=claude-fable-5
ANTHROPIC_MODEL_BUILDER=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_MAX_COST_PER_CALL_USD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_COST_PER_CALL_USD=

MANUS_API_KEY=
# manus-1.6 | manus-1.6-lite | manus-1.6-max
MANUS_AGENT_PROFILE=manus-1.6
MANUS_POLL_INTERVAL_MS=3000
MANUS_POLL_TIMEOUT_MS=300000
MANUS_MAX_COST_PER_CALL_USD=

# --- Supabase (persistência de ai_tasks/ai_runs/ai_evidence — ver Fase 11) ---
SUPABASE_URL=
# Segredo exclusivo do backend. Nunca expor em cliente, log ou commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Execução (Fase 7) ---
# READ_ONLY | ASSISTED | AUTONOMOUS — default é sempre READ_ONLY
ORCHESTRATOR_MODE=READ_ONLY
DRY_RUN=true

# --- Cost Control (Fase 16) ---
MAX_COST_PER_TASK_USD=1.00
REQUIRE_CONFIRMATION_ABOVE_USD=0.50

# --- Result Memory / economia de tokens ---
# Reutiliza somente tarefas READ concluídas, aprovadas e com chave idêntica.
RESULT_MEMORY_ENABLED=true
RESULT_MEMORY_MAX_AGE_HOURS=168

# --- n8n (Fase 13 — trigger layer, não substitui o n8n) ---
# Use um segredo aleatório com pelo menos 32 caracteres.
N8N_WEBHOOK_SECRET=
PORT=3000

# --- MCP local somente leitura ---
# user | service | agent; precisa ter permissão em ai_project_permissions.
MCP_PRINCIPAL_TYPE=agent
MCP_PRINCIPAL_ID=

# --- Observability ---
LOG_LEVEL=info
